---
import Icon from './ui/Icon.astro';

interface Props {
  features: string[];
  dot: 'aqua' | 'sky';
}

const { features } = Astro.props;
---

<ul class="feature-list grid gap-x-10 sm:grid-cols-2" data-reveal-stagger>
  {
    features.map((f, i) => (
      <li class="flex gap-3.5 border-t border-ink/8 py-4 text-[1rem] leading-relaxed text-slate">
        <span class="feature-dot mt-[0.1em] flex size-5 shrink-0 items-center justify-center rounded-md" style={`--i:${i}`} aria-hidden="true">
          <Icon name="check" size={12} class="feature-dot__icon" />
        </span>
        <span>{f}</span>
      </li>
    ))
  }
</ul>

<style>
  :global(.js) .feature-list > li {
    opacity: 1;
    transform: none;
  }

  /* Every box uses the same mint check. */
  .feature-dot {
    background-color: color-mix(in srgb, var(--color-mint) 42%, white);
    color: var(--color-mint-ink);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--color-mint) 32%, transparent),
      0 0 14px 1px color-mix(in srgb, var(--color-mint) 70%, transparent);
  }

  .feature-dot__icon {
    color: inherit;
  }

  /* Until the list scrolls into view the boxes are empty. They then fill one after another. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .feature-list > li:not(:global(.is-revealed)) .feature-dot {
      background-color: transparent;
      color: transparent;
      box-shadow: inset 0 0 0 1.5px rgb(22 33 58 / 0.16);
    }

    :global(.js) .feature-dot {
      transition:
        background-color 460ms ease,
        color 380ms ease,
        box-shadow 460ms ease;
      transition-delay: calc(var(--i) * 180ms);
    }
  }
</style>
