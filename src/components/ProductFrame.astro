---
import type { ImageSlot } from '../data/media';
import { SHOW_REVIEW_FLAGS } from '../data/config';
import MediaSlot from './ui/MediaSlot.astro';

interface Props {
  product: 'Verdicta' | 'Veritune';
  screenshot: ImageSlot | null;
}

const { product, screenshot } = Astro.props;
const accent = product === 'Verdicta' ? 'aqua' : 'sky';
---

<figure class="glass-flat overflow-hidden rounded-[1.5rem] p-2 sm:p-3" data-reveal>
  <div class="flex items-center gap-3 px-2 pt-1 pb-3 sm:px-3">
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="size-2.5 rounded-full bg-ink/12"></span>
      <span class="size-2.5 rounded-full bg-ink/12"></span>
      <span class="size-2.5 rounded-full bg-ink/12"></span>
    </span>
    <span class="mx-auto flex h-7 min-w-0 items-center rounded-full bg-white/70 px-4 font-sans text-[0.75rem] font-medium tracking-[0.02em] text-slate">
      <span class:list={['mr-2 size-1.5 shrink-0 rounded-full', accent === 'aqua' ? 'bg-aqua' : 'bg-sky']} aria-hidden="true"
      ></span>
      <span class="truncate">{product}</span>
    </span>
    <span class="w-[2.625rem]" aria-hidden="true"></span>
  </div>

  {
    screenshot ? (
      <MediaSlot
        image={screenshot}
        sizes="(min-width: 1200px) 1176px, 100vw"
        class="overflow-hidden rounded-[1rem]"
        imgClass="w-full h-auto"
      />
    ) : (
      <div
        class="frame-placeholder relative aspect-[4/3] overflow-hidden rounded-[1rem] bg-mist/50 ring-1 ring-ink/5 sm:aspect-[16/9] lg:aspect-[2.4/1]"
        role="img"
        aria-label={`${product} product interface`}
      >
        <div class="absolute inset-0 grid grid-cols-[22%_1fr] gap-4 p-4 sm:grid-cols-[18%_1fr] sm:gap-6 sm:p-6" aria-hidden="true">
          <div class="flex flex-col gap-3 rounded-xl bg-white/60 p-3 sm:p-4">
            <span class="h-3 w-3/4 rounded-full bg-ink/10" />
            <span class="mt-2 h-2.5 w-full rounded-full bg-ink/6" />
            <span class="h-2.5 w-5/6 rounded-full bg-ink/6" />
            <span class="h-2.5 w-2/3 rounded-full bg-ink/6" />
            <span class="h-2.5 w-4/5 rounded-full bg-ink/6" />
            <span class="h-2.5 w-3/5 rounded-full bg-ink/6" />
          </div>
          <div class="flex flex-col gap-4 sm:gap-5">
            <div class="grid grid-cols-3 gap-3 sm:gap-4">
              {[0, 1, 2].map(() => (
                <span class="flex h-12 flex-col justify-center gap-2 rounded-xl bg-white/80 px-3 ring-1 ring-ink/5 sm:h-20 sm:px-4">
                  <span class="h-2 w-1/2 rounded-full bg-ink/8" />
                  <span class="h-3.5 w-1/3 rounded-full bg-ink/12 max-sm:hidden" />
                </span>
              ))}
            </div>
            <div class="relative flex-1 rounded-xl bg-white/80 ring-1 ring-ink/5">
              <svg class="absolute inset-x-4 bottom-4 h-1/2 w-[calc(100%-2rem)]" viewBox="0 0 400 100" preserveAspectRatio="none">
                <path
                  d="M0 70 C 40 60, 60 30, 100 40 S 160 80, 200 55 S 260 20, 300 35 S 360 60, 400 30"
                  fill="none"
                  class:list={[accent === 'aqua' ? 'stroke-aqua' : 'stroke-sky']}
                  stroke-width="2"
                  vector-effect="non-scaling-stroke"
                />
              </svg>
            </div>
          </div>
        </div>
        <div class="frame-shimmer absolute inset-0" aria-hidden="true" />
        {SHOW_REVIEW_FLAGS && (
          <span class="dev-label absolute bottom-3 left-1/2 -translate-x-1/2 whitespace-nowrap">
            Product screenshot to be supplied
          </span>
        )}
      </div>
    )
  }
</figure>

<style>
  .frame-shimmer {
    width: 50%;
    background: linear-gradient(100deg, transparent 0%, rgb(255 255 255 / 0.6) 50%, transparent 100%);
    transform: translateX(-100%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .frame-shimmer {
      animation: shimmer 3.6s ease-in-out infinite;
    }
  }
  @keyframes shimmer {
    to {
      transform: translateX(200%);
    }
  }
</style>
