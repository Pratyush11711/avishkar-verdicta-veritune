---
import type { IconSlot } from '../../data/media';

interface Props {
  icon: IconSlot;
  /** Tile size in px, 64 to 96. Files are 240px so they stay crisp at 2x and above. */
  size?: 64 | 72 | 80 | 88 | 96;
  class?: string;
}

const { icon, size = 80, class: className } = Astro.props;
const inner = Math.round(size * 0.74);
---

<span
  class:list={[
    'icon-tile relative flex shrink-0 items-center justify-center rounded-[1.375rem] ring-1 ring-white shadow-[inset_0_1px_0_rgb(255_255_255/0.9)]',
    className,
  ]}
  style={`width:${size}px;height:${size}px`}
>
  <picture class="block" style={`width:${inner}px;height:${inner}px`}>
    <source type="image/webp" srcset={icon.webp} />
    <img
      src={icon.png}
      width={inner}
      height={inner}
      alt=""
      loading="lazy"
      decoding="async"
      class="size-full object-contain drop-shadow-[0_8px_10px_rgb(22_33_58/0.10)]"
    />
  </picture>
</span>

<style>
  /* Pale aqua taken from the glass icons, so the tile reads as part of the object. */
  .icon-tile {
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-aqua) 10%, white),
      color-mix(in srgb, var(--color-aqua) 28%, white)
    );
  }
</style>
