---
import { hero, heroCards } from '../data/copy';
import { PILOT_CTA_HREF, SECTION_IDS } from '../data/config';
import { images, heroGeometry } from '../data/media';
import Button from './ui/Button.astro';
import MediaSlot from './ui/MediaSlot.astro';
import FloatingCard from './FloatingCard.astro';
import { splitAccent } from '../lib/accent';

/** The accent phrase gets its own element so GSAP can target it separately from the rest of the line. */
const headlineParts = splitAccent(hero.headline);

const { orbs, pulse, orbRadius } = heroGeometry;
const ratio = images.hero.height / images.hero.width;

const stageVars = [
  `--ratio:${ratio.toFixed(5)}`,
  `--orb-r:${orbRadius}`,
  `--pulse-x:${pulse.x}%`,
  `--pulse-y:${pulse.y}%`,
  `--pulse-len:${pulse.length}%`,
  `--pulse-angle:${pulse.angle}deg`,
].join(';');
---

<section id={SECTION_IDS.top} data-hero aria-labelledby="hero-heading" class="hero relative isolate">
  <div class="hero-text page relative z-10 pt-32 text-center sm:pt-36 lg:pt-40" data-hero-text>
    <div class="hero-aurora" aria-hidden="true">
      <i class="hero-aurora__blob hero-aurora__blob--aqua" data-anim="blob" data-depth="0.3"></i>
      <i class="hero-aurora__blob hero-aurora__blob--sky" data-anim="blob" data-depth="0.5"></i>
      <i class="hero-aurora__blob hero-aurora__blob--mint" data-anim="blob" data-depth="0.7"></i>
      <i class="hero-aurora__blob hero-aurora__blob--apricot" data-anim="blob" data-depth="0.9"></i>
      <i class="hero-spot"></i>
    </div>

    <p
      class="hero-eyebrow glass-flat mx-auto inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-[0.8125rem] font-medium sm:px-4 sm:text-[0.875rem]"
      data-anim="eyebrow"
    >
      <span class="hero-dot" aria-hidden="true"></span>
      <span class="hero-shiny">{hero.eyebrow}</span>
    </p>

    <h1 id="hero-heading" class="mx-auto mt-6 max-w-[17em] text-hero font-semibold" data-anim="headline">
      {
        headlineParts.map((p) =>
          p.accent ? (
            <em class="accent headline-accent" data-anim="headline-accent">
              {p.text}
            </em>
          ) : (
            p.text
          ),
        )
      }
    </h1>

    <p class="mx-auto mt-6 max-w-[62ch] text-lead text-slate" data-anim="sub">{hero.subhead}</p>

    <div class="mt-9 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
      <Button href={PILOT_CTA_HREF} icon="arrow-right" class="btn-shine" data-anim="cta">
        {hero.primary}
      </Button>
      <Button href={`#${SECTION_IDS.pilot}`} variant="secondary" icon="arrow-down" data-anim="cta">
        {hero.secondary}
      </Button>
    </div>

    <p class="mx-auto mt-5 max-w-[64ch] text-[0.9375rem] leading-relaxed text-ink/75" data-anim="microcopy">
      {hero.underButtons}
    </p>
  </div>

  <div class="hero-stage" style={stageVars}>
    <MediaSlot
      image={images.hero}
      sizes="(min-width: 1920px) 1920px, 100vw"
      priority
      cropOnMobile
      decorative={false}
      class="absolute inset-0"
      imgClass="size-full object-cover"
    />

    <div class="hero-pulse" aria-hidden="true"><span class="hero-pulse__streak"></span></div>

    <div class="hidden xl:block" aria-hidden="true">
      {
        heroCards.map((card, i) => {
          const o = orbs[card.orb];
          return (
            <FloatingCard
              card={card}
              class="orb-card"
              data-side={o.side}
              data-scroll-float
              style={`--x:${o.x};--y:${o.y};--stem:${o.stem}px;--i:${i}`}
            />
          );
        })
      }
    </div>
  </div>

  <div
    class="hero-compact page relative z-10 flex flex-col items-center justify-center gap-3 sm:flex-row xl:hidden"
    aria-hidden="true"
  >
    {
      heroCards
        .filter((c) => c.compact)
        .map((card, i) => <FloatingCard card={card} class="hero-card-in" data-scroll-float style={`--i:${i}`} />)
    }
  </div>
</section>

<style>
  .hero {
    overflow-x: clip;
  }

  .hero-text::before {
    content: '';
    position: absolute;
    inset: 2rem 0 -9rem;
    z-index: -1;
    background: radial-gradient(
      closest-side at 50% 50%,
      color-mix(in srgb, var(--color-mist) 94%, transparent) 0%,
      color-mix(in srgb, var(--color-mist) 86%, transparent) 62%,
      color-mix(in srgb, var(--color-mist) 0%, transparent) 100%
    );
    pointer-events: none;
  }

  /* Aurora: soft colour behind the headline, faded out toward the edges. GSAP owns the motion. */
  .hero-aurora {
    position: absolute;
    inset: -1rem 0 -7rem;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    -webkit-mask-image: radial-gradient(closest-side at 50% 46%, #000 0%, #000 52%, transparent 100%);
    mask-image: radial-gradient(closest-side at 50% 46%, #000 0%, #000 52%, transparent 100%);
  }

  .hero-aurora__blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(56px);
    opacity: 0.55;
  }

  html.js .hero-aurora__blob[data-anim] {
    will-change: transform;
  }

  .hero-aurora__blob--aqua {
    left: 8%;
    top: 12%;
    width: 34rem;
    height: 20rem;
    background: radial-gradient(closest-side, var(--color-aqua), transparent);
  }

  .hero-aurora__blob--sky {
    right: 6%;
    top: 4%;
    width: 36rem;
    height: 22rem;
    background: radial-gradient(closest-side, var(--color-sky), transparent);
  }

  .hero-aurora__blob--mint {
    left: 34%;
    top: 30%;
    width: 28rem;
    height: 16rem;
    background: radial-gradient(closest-side, var(--color-mint), transparent);
  }

  .hero-aurora__blob--apricot {
    right: 24%;
    top: 46%;
    width: 18rem;
    height: 10rem;
    opacity: 0.32;
    background: radial-gradient(closest-side, var(--color-apricot), transparent);
  }

  /* Cursor spotlight. Hidden until the pointer moves over the hero. */
  .hero-spot {
    position: absolute;
    left: var(--mx, 50%);
    top: var(--my, 40%);
    width: 30rem;
    height: 30rem;
    margin: -15rem 0 0 -15rem;
    border-radius: 9999px;
    background: radial-gradient(closest-side, rgb(255 255 255 / 0.75), rgb(255 255 255 / 0));
    opacity: 0;
    transition: opacity 400ms ease;
  }

  :global([data-hero-text].is-spot) .hero-spot {
    opacity: 1;
  }

  /* Eyebrow: Shiny Text sweep; the dot's pulse is driven by GSAP. */
  .hero-eyebrow {
    color: rgb(22 33 58 / 0.78);
  }

  .hero-dot {
    display: inline-block;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 9999px;
    background: var(--color-aqua);
  }

  .hero-shiny {
    color: transparent;
    background-image: linear-gradient(110deg, rgb(22 33 58 / 0.78) 38%, #1d6a9e 50%, rgb(22 33 58 / 0.78) 62%);
    background-size: 220% 100%;
    background-position: 130% 0;
    -webkit-background-clip: text;
    background-clip: text;
  }

  /* The accent phrase: a static gradient fill. GSAP sweeps its background-position once after the reveal. */
  .headline-accent {
    background-image: linear-gradient(
      100deg,
      var(--color-ink) 0%,
      color-mix(in srgb, var(--color-sky) 62%, var(--color-ink)) 28%,
      color-mix(in srgb, var(--color-aqua) 58%, var(--color-ink)) 52%,
      color-mix(in srgb, var(--color-sky) 62%, var(--color-ink)) 76%,
      var(--color-ink) 100%
    );
    background-size: 240% 100%;
    background-position: 0% 50%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-block: 0.06em 0.22em;
    padding-left: 0.06em;
    margin-block: -0.06em -0.22em;
    margin-left: -0.06em;
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-shiny {
      animation: hero-shine 3.4s linear 1.2s infinite;
    }

    :global([data-offscreen]) .hero-shiny {
      animation-play-state: paused;
    }
  }

  @keyframes hero-shine {
    from {
      background-position: 130% 0;
    }
    to {
      background-position: -30% 0;
    }
  }

  /* Image box. Everything inside is positioned in cqw so it tracks the render exactly. */
  .hero-stage {
    position: relative;
    container-type: inline-size;
    width: 100%;
    max-width: 1920px;
    margin-inline: auto;
    aspect-ratio: 4 / 3;
    margin-top: calc(1rem - 15vw);
  }
  .hero-stage > :global(picture) {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 34%, #000 84%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 34%, #000 84%, transparent 100%);
  }

  @media (min-width: 768px) {
    .hero-stage {
      aspect-ratio: 1 / var(--ratio);
      /* Tuck the empty sky (top ~37% of the render) under the text block. */
      margin-top: calc(1.5rem - min(100vw, 1920px) * 0.185);
    }
  }

  @media (min-width: 1921px) {
    .hero-stage > :global(picture) {
      -webkit-mask-image:
        linear-gradient(to bottom, transparent 0%, #000 34%, #000 84%, transparent 100%),
        linear-gradient(to right, transparent 0%, #000 8%, #000 92%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask-image:
        linear-gradient(to bottom, transparent 0%, #000 34%, #000 84%, transparent 100%),
        linear-gradient(to right, transparent 0%, #000 8%, #000 92%, transparent 100%);
      mask-composite: intersect;
    }
  }

  /* ---------- Cards anchored to the orbs (desktop) ---------- */
  .hero-stage :global(.orb-card) {
    --stem-len: 2.5rem;
    position: absolute;
    left: calc(var(--x) * 1cqw - var(--stem));
  }
  .hero-stage :global(.orb-card[data-side='below']) {
    top: calc(var(--y) * var(--ratio) * 1cqw + var(--orb-r) * 1cqw + var(--stem-len));
  }
  .hero-stage :global(.orb-card[data-side='above']) {
    bottom: calc((100 - var(--y)) * var(--ratio) * 1cqw + var(--orb-r) * 1cqw + var(--stem-len));
  }
  .hero-stage :global(.orb-card)::before,
  .hero-stage :global(.orb-card)::after {
    content: '';
    position: absolute;
    left: var(--stem);
    pointer-events: none;
  }
  .hero-stage :global(.orb-card)::before {
    width: 1px;
    height: var(--stem-len);
    margin-left: -0.5px;
  }
  .hero-stage :global(.orb-card)::after {
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 9999px;
    background: var(--color-white);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-ink) 35%, transparent);
  }
  .hero-stage :global(.orb-card[data-side='below'])::before {
    bottom: 100%;
    background: linear-gradient(to top, color-mix(in srgb, var(--color-ink) 35%, transparent), transparent);
  }
  .hero-stage :global(.orb-card[data-side='below'])::after {
    bottom: calc(100% + var(--stem-len) - 2.5px);
  }
  .hero-stage :global(.orb-card[data-side='above'])::before {
    top: 100%;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--color-ink) 35%, transparent), transparent);
  }
  .hero-stage :global(.orb-card[data-side='above'])::after {
    top: calc(100% + var(--stem-len) - 2.5px);
  }

  /* ---------- Compact cards (tablet and mobile) ---------- */
  .hero-compact {
    margin-top: -4.5rem;
    padding-bottom: 1rem;
  }
  @media (min-width: 768px) {
    .hero-compact {
      margin-top: calc(-1 * min(100vw, 1920px) * 0.1);
    }
  }

  /* ---------- Pulse along the straight part of the cord ---------- */
  .hero-pulse {
    display: none;
    position: absolute;
    left: var(--pulse-x);
    top: var(--pulse-y);
    width: var(--pulse-len);
    height: 0;
    transform: rotate(var(--pulse-angle));
    transform-origin: 0 50%;
    pointer-events: none;
    overflow: visible;
  }
  .hero-pulse__streak {
    position: absolute;
    left: 0;
    top: -0.6cqw;
    width: 20%;
    height: 1.2cqw;
    border-radius: 9999px;
    background: radial-gradient(
      50% 50% at 50% 50%,
      rgb(255 255 255 / 0.95) 0%,
      rgb(255 255 255 / 0.55) 40%,
      rgb(255 255 255 / 0) 100%
    );
    opacity: 0;
  }

  /* The cord image stays still. The traveling light streak is not shown. */

  @keyframes hero-pulse {
    0% {
      transform: translateX(-60%);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    55% {
      opacity: 0.9;
    }
    68% {
      transform: translateX(480%);
      opacity: 0;
    }
    100% {
      transform: translateX(480%);
      opacity: 0;
    }
  }

  /* Scroll Float (React Bits): cards start sunk and stretched, then rise into place. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero-stage :global(.orb-card),
    :global(.js) .hero :global(.hero-card-in) {
      opacity: 0;
      transform: translateY(72%) scale(0.88, 1.28);
      transform-origin: 50% 0%;
      will-change: transform, opacity;
    }

    :global(.js) .hero-stage :global(.orb-card[data-side='above']) {
      transform-origin: 50% 100%;
    }
  }
</style>

<script>
  import '../scripts/hero-pulse.ts';
  import '../scripts/hero-spot.ts';
  import '../scripts/hero-motion.ts';
</script>
