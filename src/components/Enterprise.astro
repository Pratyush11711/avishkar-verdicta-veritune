---
import { enterprise } from '../data/copy';
import { SECTION_IDS } from '../data/config';
import { icons } from '../data/media';
import Flag from './ui/Flag.astro';
import IconTile from './ui/IconTile.astro';
import Reveal from './ui/Reveal.astro';
import RichText from './ui/RichText.astro';

const spans = [
  'bento-deploy',
  'bento-security',
  'bento-integrations',
  'bento-access',
  'bento-white',
  'bento-dash',
];
const glassTints = ['var(--color-aqua)', 'var(--color-sky)', 'var(--color-mint)', 'var(--color-apricot)'];
---

<section id={SECTION_IDS.enterprise} aria-labelledby="enterprise-heading" class="section-y glow-aqua">
  <div class="page">
    <Reveal class="max-w-[42rem]">
      <h2 id="enterprise-heading" class="text-h2">{enterprise.heading}</h2>
      <p class="mt-6 text-body">{enterprise.body}</p>
    </Reveal>

    <Reveal as="ul" stagger class="bento mt-12 lg:mt-14">
      {
        enterprise.cards.map((card, i) => (
          <li
            class:list={['bento-card liquid-glass rounded-card', spans[i]]}
            style={`--lg-tint: ${glassTints[i % glassTints.length]}`}
          >
            <div class="bento-card__content">
              <IconTile icon={icons[card.icon]} size={72} class="bento-card__icon" />
              <h3 class="mt-5 text-h3">{card.title}</h3>
              <p class="mt-2 max-w-[42rem] text-[1rem] leading-relaxed text-slate">
                <RichText segments={card.body} />
              </p>
              {
                card.title === 'Integrations' && (
                  <div class="logo-groups">
                    {enterprise.logoGroups.map((group) => (
                      <div class="logo-group">
                        <Flag note={group.note}>
                          <span class="label-mono text-slate">{group.label}</span>
                        </Flag>
                        <span class="logo-row">
                          {group.items.map((item) => (
                            <span class="logo-chip">
                              <img src={item.src} alt={item.name} decoding="async" />
                              {'label' in item && item.label ? <span class="logo-chip__name">{item.label}</span> : null}
                            </span>
                          ))}
                        </span>
                      </div>
                    ))}
                  </div>
                )
              }
            </div>
          </li>
        ))
      }
    </Reveal>
  </div>
</section>

<style>
  /* Aceternity bento (Manu Arora): mixed spans, content sitting at the bottom of each cell. */
  .bento {
    display: grid;
    gap: 1rem;
  }

  .bento-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 12.5rem;
    overflow: hidden;
    padding: 1.5rem;
  }

  .bento-integrations {
    justify-content: flex-start;
  }

  .bento-integrations .bento-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    width: 100%;
  }

  .logo-groups {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  .logo-group :global(.review-flag) {
    display: inline-flex;
    text-decoration: none;
  }

  .logo-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.55rem;
  }

  .logo-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 3.15rem;
    padding: 0.4rem 0.75rem;
    border-radius: 0.85rem;
    background: white;
    box-shadow: inset 0 0 0 1px rgb(22 33 58 / 0.06);
  }

  .logo-chip img {
    display: block;
    height: 1.7rem;
    width: auto;
    max-width: 9.5rem;
    object-fit: contain;
  }

  .logo-chip__name {
    margin-left: 0.45rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .bento-card__content {
    position: relative;
    z-index: 1;
  }

  .bento-card :global(.bento-card__icon) {
    transform-origin: left center;
    transition: transform 300ms ease;
  }

  @media (min-width: 40rem) {
    .bento {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }

    .bento-integrations,
    .bento-dash {
      grid-column: span 2;
    }
  }

  @media (min-width: 64rem) {
    .bento {
      grid-template-columns: 1.2fr 1.2fr 0.9fr;
      grid-template-rows: auto auto auto;
    }

    .bento-integrations {
      grid-column: 1 / 3;
      grid-row: 1 / 3;
    }

    .bento-security {
      grid-column: 3;
      grid-row: 1;
    }

    .bento-deploy {
      grid-column: 3;
      grid-row: 2;
    }

    .bento-access {
      grid-column: 1;
      grid-row: 3;
    }

    .bento-white {
      grid-column: 2;
      grid-row: 3;
    }

    .bento-dash {
      grid-column: 3;
      grid-row: 3;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .bento-card__content {
      transition: transform 300ms ease;
    }

    .bento-card:hover .bento-card__content {
      transform: translateY(-10px);
    }

    .bento-card:hover :global(.bento-card__icon) {
      transform: scale(0.75);
    }
  }
</style>
