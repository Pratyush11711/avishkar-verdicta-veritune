---
import { suite } from '../data/copy';
import { SECTION_IDS } from '../data/config';
import { images } from '../data/media';
import GlowText from './ui/GlowText.astro';
import MediaSlot from './ui/MediaSlot.astro';
import Reveal from './ui/Reveal.astro';
---

<section id={SECTION_IDS.suite} aria-labelledby="suite-line" class="band relative isolate overflow-hidden">
  <MediaSlot
    image={images.suite}
    label="IMG 4 · 21:9"
    sizes="100vw"
    cropOnMobile
    decorative
    class="band-media absolute inset-0 -z-10"
    imgClass="size-full object-cover object-bottom"
  />
  <div class="page band-content">
    <Reveal class="mx-auto max-w-[46rem] text-center">
      <p class="text-[0.75rem] font-medium tracking-[0.16em] text-ink uppercase">{suite.eyebrow}</p>
      <GlowText id="suite-line" as="h2" class="mt-5 text-h2 font-semibold text-balance" text={suite.heading} />
      <GlowText
        as="p"
        class="suite-accent mt-2 text-[clamp(1.75rem,1.2rem+1.6vw,2.5rem)] leading-[1.2] text-balance"
        text={suite.accent}
      />
      <GlowText as="p" class="mt-5 text-[1.0625rem] leading-relaxed text-slate" text={suite.line} />
    </Reveal>
  </div>
</section>

<style>
  /* Italic serif, without the accent gradient. That gradient clips the fill to
     transparent, which hides the glowing letters. */
  .band :global(.suite-accent) {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-ink);
    -webkit-text-fill-color: currentColor;
    background: none;
  }

  /* Render is 16:9 with the cord at ~59% height and empty sky above it. */
  /* Mobile: the render sits in the bottom 24rem only, so the orbs never run under the text. */
  .band-content {
    padding-top: 4rem;
    padding-bottom: 15rem;
  }
  .band :global(.band-media) {
    top: auto;
    height: 24rem;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 30%, #000 84%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 30%, #000 84%, transparent 100%);
  }
  @media (min-width: 768px) {
    /* Width stays 100%. aspect-ratio plus max-height shrinks the used width
       once the 16:9 height hits the cap, which leaves a gap beside the image. */
    .band {
      width: 100%;
      height: min(56.25vw, 56rem);
    }
    .band :global(.band-media) {
      inset: 0;
      width: 100%;
      height: 100%;
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);
      mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);
    }
    .band :global(.band-media img) {
      width: 100%;
      height: 100%;
      max-width: none;
      object-fit: cover;
      object-position: center bottom;
    }
    .band-content {
      padding-top: 15%;
      padding-bottom: 0;
    }
  }
  @media (min-width: 1280px) {
    .band-content {
      padding-top: min(12vw, 13rem);
    }
  }
</style>
