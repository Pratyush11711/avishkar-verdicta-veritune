---
import { suite } from '../data/copy';
import { SECTION_IDS } from '../data/config';
import { images } from '../data/media';
import MediaSlot from './ui/MediaSlot.astro';

const breakAt = suite.heading.indexOf(' your ');
const headlineLead = breakAt > 0 ? suite.heading.slice(0, breakAt) : suite.heading;
const headlineRest = breakAt > 0 ? suite.heading.slice(breakAt + 1) : '';
---

<section id={SECTION_IDS.suite} aria-labelledby="suite-line" class="band relative isolate" data-anim="suite">
  <div class="band-frame" data-anim="frame">
  <div class="band-scene" data-anim="scene">
    <div class="band-scene__bg" data-anim="scene-bg">
      <MediaSlot
        image={images.suite}
        label="IMG 4 · 21:9"
        sizes="100vw"
        cropOnMobile
        decorative
        class="absolute inset-0"
        imgClass="size-full object-cover object-bottom"
      />
    </div>
  </div>
  </div>
  <div class="page band-content" data-anim="copy">
    <div class="mx-auto max-w-[46rem] text-center">
      <p class="text-[0.75rem] font-medium text-ink uppercase" data-anim="eyebrow">{suite.eyebrow}</p>
      <h2 id="suite-line" class="mt-5 text-h2 font-semibold" data-anim="headline">
        <span class="block">{headlineLead}</span>
        {headlineRest && <span class="block">{headlineRest}</span>}
      </h2>
      <p class="suite-accent mt-2 text-[clamp(1.75rem,1.2rem+1.6vw,2.5rem)] leading-[1.2] text-balance" data-anim="italic">
        {suite.accent}
      </p>
      <p class="mt-5 text-[1.0625rem] leading-relaxed text-slate" data-anim="sub">{suite.line}</p>
    </div>
  </div>
</section>

<style>
  .suite-accent {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-ink);
  }

  /* SplitText line masks and the one-shot teal glow on "customers reacted". */
  :global(.suite-line) {
    display: block;
  }
  :global(.suite-word) {
    display: inline-block;
    white-space: nowrap;
  }
  :global(.suite-word-glow) {
    animation: suite-word-glow 1s ease-out forwards;
  }
  @keyframes suite-word-glow {
    0% {
      text-shadow: 0 0 18px color-mix(in srgb, var(--suite-teal, var(--color-aqua)) 85%, white);
    }
    100% {
      text-shadow: 0 0 0 transparent;
    }
  }

  /* Ready for separate scene layers. Hidden until the intro reveals them. */
  :global([data-anim='tube']) {
    position: relative;
    overflow: hidden;
    transform-origin: 50% 100%;
  }
  :global([data-anim='tube-streak']) {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.85), transparent);
  }
  :global([data-anim='floor-ring']) {
    position: absolute;
    left: 50%;
    top: 58%;
    width: 9rem;
    height: 9rem;
    margin: -4.5rem 0 0 -4.5rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--suite-peach, var(--color-apricot)) 75%, white);
    pointer-events: none;
  }
  :global([data-anim='glow']) {
    transform-origin: 50% 50%;
  }

  .band-frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform-origin: 50% 0;
  }
  .band-scene {
    position: absolute;
    z-index: 0;
    overflow: hidden;
    transform-origin: 50% 60%;
  }
  .band-scene__bg {
    position: absolute;
    inset: 0;
    transform-origin: 50% 60%;
  }

  /* Render is 16:9 with the cord low and empty sky above the copy. */
  .band-content {
    position: relative;
    z-index: 1;
    padding-top: 4rem;
    padding-bottom: 15rem;
  }
  .band-scene {
    right: 0;
    bottom: 0;
    left: 0;
    height: 24rem;
  }
  @media (min-width: 768px) {
    .band {
      width: 100%;
      height: min(56.25vw, 56rem);
    }
    .band-scene {
      inset: 0;
      height: auto;
    }
    .band-content {
      padding-top: 15%;
      padding-bottom: 0;
    }
  }
  @media (min-width: 1280px) {
    .band-content {
      padding-top: min(12vw, 13rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.suite-word-glow) {
      animation: none;
    }
  }
</style>

<script>
  import '../scripts/animations/hero.ts';
</script>
