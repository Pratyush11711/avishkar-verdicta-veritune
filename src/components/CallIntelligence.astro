---
import Icon from './ui/Icon.astro';

interface Props {
  product: 'Verdicta' | 'Veritune';
}

type Tone = 'pass' | 'flag';
interface Row {
  label: string;
  value: string;
  tone: Tone;
  check?: boolean;
}

const { product } = Astro.props;
const isVerdicta = product === 'Verdicta';

const rows: Row[] = isVerdicta
  ? [
      { label: 'Script adherence', value: 'Checked', tone: 'pass', check: true },
      { label: 'Required disclosure', value: 'Checked', tone: 'pass', check: true },
      { label: 'CRM tagging', value: 'Checked', tone: 'pass', check: true },
    ]
  : [
      { label: 'Customer tone', value: 'Neutral \u2192 frustrated', tone: 'pass' },
      { label: 'Competitor mentions', value: 'Flagged', tone: 'flag' },
      { label: 'Recommended action', value: 'Retention follow-up', tone: 'pass' },
    ];

/** Deterministic bar heights (percent), so the waveform looks organic but renders the same every build. */
const BAR_COUNT = 38;
const bars = Array.from({ length: BAR_COUNT }, (_, i) => {
  const v = Math.abs(Math.sin(i * 1.37) * 0.55 + Math.sin(i * 0.43 + 1) * 0.45);
  return Math.round(24 + v * 76);
});
---

<figure
  class:list={['call-card', isVerdicta ? 'call-card--aqua' : 'call-card--sky']}
  aria-label={`${product} call intelligence, illustrative view`}
  data-reveal
>
  <header class="call-card__head">
    <p class="flex items-center gap-3 text-[0.9375rem]">
      <span class="call-card__dot" aria-hidden="true"></span>
      <span class="font-semibold text-ink">{product}</span>
      <span class="text-slate">Call intelligence</span>
    </p>
    <span class="label-mono text-slate">Illustrative view</span>
  </header>

  <div class="call-card__body">
    <div class="call-card__player" data-wave-player>
      <span class="flex items-center gap-3 text-slate" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
          <path d="M4 10v4M8 6v12M12 3v18M16 7v10M20 10v4"></path>
        </svg>
        <span class="label-mono">Call recording</span>
      </span>

      <div class="wave" aria-hidden="true">
        {
          bars.map((h, i) => (
            <span class="wave__bar" style={`--h:${h}%;--i:${i}`} />
          ))
        }
      </div>

      <div class="flex items-center gap-3 text-slate">
        <button type="button" class="call-card__play" aria-pressed="true" aria-label="Pause waveform animation" data-wave-toggle>
          <svg class="play-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round">
            <path d="M7 4.5v15l12-7.5z"></path>
          </svg>
          <svg class="pause-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <rect x="6" y="4.5" width="4" height="15" rx="1"></rect>
            <rect x="14" y="4.5" width="4" height="15" rx="1"></rect>
          </svg>
        </button>
        <span class="label-mono">04:32</span>
      </div>
    </div>

    <ul class="call-card__rows">
      {
        rows.map((r) => (
          <li class="flex items-center justify-between gap-4">
            <span class="text-[0.875rem] text-ink">{r.label}</span>
            <span class:list={['call-pill', r.tone === 'flag' ? 'call-pill--flag' : 'call-pill--pass']}>
              {r.value}
              {r.check && <Icon name="check" size={12} />}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</figure>

<style>
  .call-card {
    --tone: var(--color-aqua);
    border-radius: 1.25rem;
    border: 1px solid rgb(22 33 58 / 0.08);
    background: rgb(255 255 255 / 0.82);
    box-shadow:
      0 24px 60px color-mix(in srgb, var(--color-ink) 6%, transparent),
      0 1px 2px color-mix(in srgb, var(--color-ink) 4%, transparent);
    overflow: hidden;
  }

  .call-card--sky {
    --tone: var(--color-sky);
  }

  .call-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid rgb(22 33 58 / 0.1);
  }

  /* Breathing dot: the core swells gently while a soft halo expands and fades out from behind it. */
  .call-card__dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--tone);
    box-shadow: 0 0 8px 1px color-mix(in srgb, var(--tone) 70%, transparent);
  }

  .call-card__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--tone);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .call-card__dot {
      animation: dot-breathe 3.2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    }

    .call-card__dot::after {
      animation: dot-halo 3.2s cubic-bezier(0.2, 0.6, 0.4, 1) infinite;
    }
  }

  @keyframes dot-breathe {
    0%,
    100% {
      transform: scale(0.85);
      box-shadow: 0 0 4px 0 color-mix(in srgb, var(--tone) 45%, transparent);
    }
    50% {
      transform: scale(1.2);
      box-shadow: 0 0 12px 2px color-mix(in srgb, var(--tone) 80%, transparent);
    }
  }

  @keyframes dot-halo {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    70%,
    100% {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  .call-card__body {
    display: grid;
    gap: 1.5rem;
    padding: 1.5rem;
    align-items: center;
  }

  @media (min-width: 64rem) {
    .call-card__body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
      gap: 3rem;
      padding: 1.75rem 2rem;
    }
  }

  .call-card__player {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .call-card__rows {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .call-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    background: color-mix(in srgb, var(--color-mint) 32%, white);
    color: var(--color-mint-ink);
  }

  .call-pill--flag {
    background: color-mix(in srgb, var(--color-apricot) 32%, white);
    color: var(--color-apricot-ink);
  }

  .call-card__play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    color: var(--color-ink);
    transition:
      background-color 200ms ease,
      transform 200ms ease;
  }

  .call-card__play:hover {
    background: rgb(22 33 58 / 0.07);
  }

  .call-card__play:active {
    transform: scale(0.92);
  }

  /* While the wave is moving the button offers "pause"; once paused it offers "play". */
  .call-card__play .play-icon {
    display: none;
  }

  .call-card__play[aria-pressed='false'] .play-icon {
    display: block;
  }

  .call-card__play[aria-pressed='false'] .pause-icon {
    display: none;
  }

  /* Waveform: a travelling swell. Every bar runs the same eased loop, offset by its index, so the
     motion reads as one continuous wave instead of random jitter. */
  .wave {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 2.5rem;
    flex: 1 1 10rem;
    min-width: 10rem;
    max-width: 17rem;
  }

  .wave__bar {
    flex: 1 1 0;
    min-width: 2px;
    max-width: 3px;
    height: var(--h);
    border-radius: 999px;
    background: var(--tone);
    opacity: 0.85;
    transform-origin: center;
    transform: scaleY(0.6);
  }

  @media (prefers-reduced-motion: no-preference) {
    .wave__bar {
      will-change: transform;
      animation: wave-swell 2.4s cubic-bezier(0.45, 0, 0.55, 1) infinite;
      animation-delay: calc(var(--i) * -85ms);
    }

    [data-wave-player].is-paused .wave__bar {
      animation-play-state: paused;
    }
  }

  @keyframes wave-swell {
    0%,
    100% {
      transform: scaleY(0.28);
      opacity: 0.55;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-wave-player]').forEach((player) => {
    const btn = player.querySelector<HTMLButtonElement>('[data-wave-toggle]');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const playing = btn.getAttribute('aria-pressed') === 'true';
      btn.setAttribute('aria-pressed', String(!playing));
      btn.setAttribute('aria-label', playing ? 'Play waveform animation' : 'Pause waveform animation');
      player.classList.toggle('is-paused', playing);
    });
  });
</script>
