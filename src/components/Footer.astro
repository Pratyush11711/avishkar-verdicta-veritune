---
// Dark closing panel. The giant wordmark carries a sheen that is already
// moving on load; hovering it hands that sheen to the cursor.
import { footer } from '../data/copy';
import { FOOTER_LINKS } from '../data/config';
import Icon from './ui/Icon.astro';

const year = new Date().getFullYear();
const logoHeight = 26;
const logoWidth = Math.round((750 / 168) * logoHeight);
---

<footer class="site-footer">
  <div class="page relative pt-14 lg:pt-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr]">
      <div class="sm:col-span-2 lg:col-span-1">
        <img
          src="/logo-white-nav.webp"
          width={logoWidth}
          height={logoHeight}
          alt="Avishkar AI"
          loading="lazy"
          decoding="async"
          class="footer-logo"
        />
        <p class="footer-copy footer-copy--soft mt-4 max-w-[36ch] text-[0.9375rem] leading-relaxed">{footer.line}</p>
        <p class="footer-badge footer-copy">
          <Icon name="shield-check" size={15} />
          <span class="label-mono">{footer.badge}</span>
        </p>
      </div>

      <nav aria-label="Footer">
        <p class="label-mono footer-copy footer-copy--faint">Explore</p>
        <ul class="mt-4 space-y-2.5">
          {
            FOOTER_LINKS.map((l) => (
              <li>
                <a href={l.href} class="footer-link footer-copy">{l.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="label-mono footer-copy footer-copy--faint">Company</p>
        <ul class="mt-4 space-y-2.5">
          <li class="footer-copy text-[0.9375rem] font-medium">Avishkar AI</li>
          <li>
            <a href="#top" class="footer-link footer-copy">Back to top</a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="page footer-legal">
    <p>© {year} Avishkar AI. All rights reserved.</p>
  </div>

  <div class="footer-mark">
    <p class="site-footer__wordmark" aria-label="Avishkar AI">Avishkar AI</p>
    <p class="site-footer__wordmark footer-spot" data-anim="wordmark-spot" aria-hidden="true">Avishkar AI</p>
  </div>
</footer>

<script>
  import '../scripts/animations/footer.ts';
</script>

<style>
  .site-footer {
    position: relative;
    overflow-x: clip;
    background: var(--color-ink);
    --orb-teal: #7ed6d0;
    --orb-blue: #8db6ee;
  }

  .footer-logo {
    display: block;
    height: 1.625rem;
    width: auto;
  }

  .footer-copy {
    --rest: rgb(255 255 255 / 0.8);
    color: var(--rest);
  }

  .footer-copy--soft {
    --rest: rgb(255 255 255 / 0.55);
  }

  .footer-copy--faint {
    --rest: rgb(255 255 255 / 0.4);
  }

  .label-mono {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .footer-badge {
    --rest: rgb(255 255 255 / 0.75);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    padding: 0.375rem 0.75rem;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.15);
  }

  .footer-link {
    position: relative;
    display: inline-block;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .footer-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.12em;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.35s ease;
  }

  .footer-link:hover::after,
  .footer-link:focus-visible::after {
    transform: scaleX(1);
  }

  .footer-link:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-aqua) 80%, white);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .footer-legal {
    margin-top: 2.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    padding-top: 1.5rem;
    padding-bottom: 0.5rem;
    color: rgb(255 255 255 / 0.45);
    font-size: 0.8125rem;
  }

  .footer-mark {
    position: relative;
  }

  .site-footer__wordmark {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 1.5rem clamp(1rem, 3vw, 2.5rem) clamp(1.25rem, 4vw, 2.5rem);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.5rem, 11vw, 8rem);
    line-height: 1;
    letter-spacing: -0.03em;
    text-align: center;
    white-space: nowrap;
    color: rgb(255 255 255 / 0.07);
    user-select: none;
  }

  .footer-spot {
    position: absolute;
    inset: 0;
    z-index: 2;
    --mx: 50;
    --my: 40;
    background: radial-gradient(
      var(--spot-r, 320px) circle at calc(var(--mx) * 1px) calc(var(--my) * 1px),
      color-mix(in srgb, var(--orb-teal) 88%, white),
      color-mix(in srgb, var(--orb-blue) 55%, transparent) 42%,
      transparent 70%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-link::after {
      transition: none;
    }
  }
</style>
