---
// Simple dark closing panel: logo and tagline, link columns, a copyright line,
// and a big dim wordmark cropped by the bottom edge.
import { footer } from '../data/copy';
import { FOOTER_LINKS } from '../data/config';
import Icon from './ui/Icon.astro';

const year = new Date().getFullYear();
const logoHeight = 26;
const logoWidth = Math.round((750 / 168) * logoHeight);
---

<footer class="site-footer relative overflow-hidden text-white/85">
  <div class="page relative pt-14 pb-10 lg:pt-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr]">
      <div class="sm:col-span-2 lg:col-span-1">
        <img src="/logo-white-nav.webp" width={logoWidth} height={logoHeight} alt="Avishkar AI" loading="lazy" decoding="async" class="block h-[1.625rem] w-auto" />
        <p class="mt-4 max-w-[36ch] text-[0.9375rem] leading-relaxed text-white/55">{footer.line}</p>
        <p class="mt-5 inline-flex items-center gap-2 rounded-full bg-white/8 px-3 py-1.5 ring-1 ring-white/15">
          <Icon name="shield-check" size={15} />
          <span class="label-mono text-white/75">{footer.badge}</span>
        </p>
      </div>

      <nav aria-label="Footer">
        <p class="label-mono text-white/40">Explore</p>
        <ul class="mt-4 space-y-2.5">
          {
            FOOTER_LINKS.map((l) => (
              <li>
                <a href={l.href} class="footer-link text-[0.9375rem] font-medium text-white/80">
                  <span class="center-underline">{l.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="label-mono text-white/40">Company</p>
        <ul class="mt-4 space-y-2.5">
          <li class="text-[0.9375rem] font-medium text-white/80">Avishkar AI</li>
          <li>
            <a href="#top" class="footer-link text-[0.9375rem] font-medium text-white/80">
              <span class="center-underline">Back to top</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-white/10 pt-6 text-[0.8125rem] text-white/45 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Avishkar AI. All rights reserved.</p>
    </div>
  </div>

  <!-- Giant dim wordmark, fully visible. Decorative only; the name is already in the logo above. -->
  <p class="site-footer__wordmark" aria-hidden="true">Avishkar AI</p>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
  }

  .label-mono {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .center-underline {
    position: relative;
    display: inline-block;
  }

  .center-underline::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -0.15em;
    width: 0;
    height: 0.0625em;
    background: currentColor;
    transform: translateX(-50%);
    transition: width 250ms ease-in-out;
  }

  .footer-link:hover .center-underline::after,
  .footer-link:focus-visible .center-underline::after {
    width: 100%;
  }

  .site-footer__wordmark {
    margin: 0;
    padding: 1.5rem clamp(1rem, 3vw, 2.5rem) clamp(1.25rem, 4vw, 2.5rem);
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    text-align: center;
    font-size: clamp(2.5rem, 11vw, 8rem);
    white-space: nowrap;
    color: rgb(255 255 255 / 0.07);
    user-select: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .center-underline::after {
      transition: none;
    }
  }
</style>
