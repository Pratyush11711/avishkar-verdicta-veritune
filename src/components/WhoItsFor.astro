---
import { audience } from '../data/copy';
import { SECTION_IDS } from '../data/config';
import { icons } from '../data/media';
import Accent from './ui/Accent.astro';
import IconTile from './ui/IconTile.astro';
import Reveal from './ui/Reveal.astro';
import RichText from './ui/RichText.astro';
---

<section id={SECTION_IDS.audience} aria-labelledby="audience-heading" class="audience section-y relative isolate overflow-clip">
  <!-- Soft colour behind the glass so the blur has something to pick up. -->
  <div class="blob blob-a" aria-hidden="true"></div>
  <div class="blob blob-b" aria-hidden="true"></div>
  <div class="blob blob-c" aria-hidden="true"></div>

  <div class="page">
    <Reveal class="mx-auto max-w-[44rem] text-center">
      <h2 id="audience-heading" class="text-h2">
        <Accent text={audience.heading} />
      </h2>
      <p class="mt-6 text-body">{audience.body}</p>
    </Reveal>

    <Reveal class="mt-6 lg:mt-8">
      <div role="group" aria-roledescription="carousel" aria-label="Who Verdicta and Veritune are built for">
        <!--
          React Bits "Circular Carousel", cylinder preset, rebuilt without React.
          The ring is drawn by script from the hidden card markup below.
        -->
        <div class="cc" data-cc tabindex="0" aria-label="Industries. Drag, swipe or use the arrow keys.">
          <div class="cc__view" aria-hidden="true">
            <div class="cc__stage" data-cc-stage>
              <div class="cc__camera" data-cc-camera>
                <div class="cc__ring" data-cc-ring></div>
              </div>
            </div>
          </div>

          <div data-cc-src hidden>
            {
              audience.cards.map((card) => (
                <div data-cc-item class="cc-content">
                  <IconTile icon={icons[card.icon]} size={80} />
                  <h3 class="mt-4 text-h3">{card.title}</h3>
                  <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-slate">
                    <RichText segments={card.body} />
                  </p>
                </div>
              ))
            }
          </div>

          <ul class="sr-only">
            {
              audience.cards.map((card) => (
                <li>
                  <strong>{card.title}.</strong> <RichText segments={card.body} />
                </li>
              ))
            }
          </ul>
          <div class="sr-only" aria-live="polite" aria-atomic="true" data-cc-live></div>
        </div>

        <div class="controls">
          <button type="button" class="nav-btn" data-wprev aria-label="Previous industry">
            <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4 6 10l6 6"></path></svg>
          </button>
          <div class="dots">
            {
              audience.cards.map((card) => (
                <button type="button" class="dot" data-wdot aria-label={`Show ${card.title}`}></button>
              ))
            }
          </div>
          <button type="button" class="nav-btn" data-wnext aria-label="Next industry">
            <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 4 6 6-6 6"></path></svg>
          </button>
        </div>
      </div>
    </Reveal>
  </div>
</section>

<style>
  .blob {
    position: absolute;
    z-index: -1;
    border-radius: 999px;
    filter: blur(60px);
    pointer-events: none;
  }
  .blob-a {
    width: 26rem;
    height: 26rem;
    left: 6%;
    top: 34%;
    background: color-mix(in srgb, var(--color-aqua) 55%, white);
    opacity: 0.55;
  }
  .blob-b {
    width: 24rem;
    height: 24rem;
    right: 8%;
    top: 40%;
    background: color-mix(in srgb, var(--color-sky) 60%, white);
    opacity: 0.55;
  }
  .blob-c {
    width: 20rem;
    height: 20rem;
    left: 40%;
    top: 55%;
    background: color-mix(in srgb, var(--color-haze) 70%, white);
    opacity: 0.5;
  }

  .controls {
    margin-top: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  .dots {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .dot {
    position: relative;
    height: 0.5rem;
    width: 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-slate) 30%, transparent);
    transition:
      width 0.3s var(--ease-out-soft),
      background-color 0.3s var(--ease-out-soft);
  }
  .dot::after {
    content: '';
    position: absolute;
    inset: -0.75rem -0.25rem;
  }
  .dot[aria-current='true'] {
    width: 1.5rem;
    background: var(--color-ink);
  }
  .nav-btn {
    display: grid;
    place-items: center;
    height: 2.5rem;
    width: 2.5rem;
    border-radius: 999px;
    color: var(--color-ink);
    background: rgb(255 255 255 / 0.7);
    border: 1px solid rgb(255 255 255 / 0.9);
    box-shadow: var(--shadow-glass);
    transition: transform 0.2s var(--ease-out-soft);
  }
  .nav-btn:hover {
    transform: translateY(-1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .dot {
      transition: none;
    }
  }
</style>

<!-- The ring is built from script-created elements, so its styles have to be global. -->
<style is:global>
  .cc {
    --cc-fade: var(--color-frost);
    position: relative;
    width: 100%;
    height: 26rem;
    overflow: hidden;
    outline: none;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    cursor: grab;
  }
  .cc[data-dragging] {
    cursor: grabbing;
  }
  .cc:focus-visible {
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--color-ink) 35%, transparent);
    border-radius: 1.25rem;
  }

  .cc__view {
    position: absolute;
    inset: 0;
  }
  .cc__stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .cc.is-ready .cc__stage {
    opacity: 1;
  }

  .cc__camera,
  .cc__ring,
  .cc__card {
    width: 0;
    height: 0;
    transform-style: preserve-3d;
  }
  .cc__camera {
    position: relative;
  }
  .cc__ring,
  .cc__card {
    position: absolute;
    left: 0;
    top: 0;
  }

  .cc__tile {
    position: absolute;
    outline: 1px solid transparent;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .cc__frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    /* Top and bottom hairlines on every strip; the side hairlines only on the outer strips. */
    box-shadow:
      inset 0 1px 0 rgb(22 33 58 / 0.07),
      inset 0 -1px 0 rgb(22 33 58 / 0.07);
  }
  .cc__frame.is-first {
    box-shadow:
      inset 0 1px 0 rgb(22 33 58 / 0.07),
      inset 0 -1px 0 rgb(22 33 58 / 0.07),
      inset 1px 0 0 rgb(22 33 58 / 0.07);
  }
  .cc__frame.is-last {
    box-shadow:
      inset 0 1px 0 rgb(22 33 58 / 0.07),
      inset 0 -1px 0 rgb(22 33 58 / 0.07),
      inset -1px 0 0 rgb(22 33 58 / 0.07);
  }
  .cc__frame.is-first.is-last {
    box-shadow: inset 0 0 0 1px rgb(22 33 58 / 0.07);
  }

  /* One card-sized sheet per strip, shifted so the strips join up into a single bent card. */
  .cc__slice {
    position: absolute;
    top: 0;
    background: linear-gradient(155deg, #ffffff, #f3f8f9);
  }
  .cc__slice--back {
    background: linear-gradient(155deg, #e8f1f1, #dce8ee);
  }
  .cc__slice .cc-content {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 1.5rem 1.625rem;
    text-align: center;
  }

  /* Cards further round the ring melt into the page background. */
  .cc__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--cc-fade);
    opacity: var(--cc-depth, 0);
  }

  @media (max-width: 639px) {
    .cc {
      height: 24rem;
    }
  }
</style>

<script>
  type Vec = [number, number, number];

  const root = document.querySelector<HTMLElement>('[data-cc]');

  if (root) {
    const stage = root.querySelector<HTMLElement>('[data-cc-stage]')!;
    const camera = root.querySelector<HTMLElement>('[data-cc-camera]')!;
    const ring = root.querySelector<HTMLElement>('[data-cc-ring]')!;
    const live = root.querySelector<HTMLElement>('[data-cc-live]');
    const sources = Array.from(root.querySelectorAll<HTMLElement>('[data-cc-src] > [data-cc-item]'));
    const dots = Array.from(document.querySelectorAll<HTMLElement>('[data-wdot]'));
    const prevBtn = document.querySelector<HTMLElement>('[data-wprev]');
    const nextBtn = document.querySelector<HTMLElement>('[data-wnext]');

    // Layout, in the units the React Bits cylinder preset uses.
    const CARD_W = 264;
    const CARD_H = 296;
    const GAP = 24;
    const CORNER = 18;
    const TILES = 8;
    const OVERLAP = 2.5;
    const TILT = -5;
    const PERSPECTIVE = 2500;
    const SPEED = 14; // degrees per second while drifting
    const MOMENTUM = 0.6;
    const DEPTH_FADE = 0.55;
    const PARALLAX = 0.3;
    const SPRING = 118;
    const SETTLE_SPEED = 9;
    const DRAG_THRESHOLD = 5;
    const INTRO_MS = 1400;
    const TO_RAD = Math.PI / 180;

    const unique = sources.length;
    // A ring of four wide cards would be mostly gaps, so each industry appears twice.
    const count = unique * 2;
    const step = 360 / count;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
    const wrap = (d: number) => ((((d + 180) % 360) + 360) % 360) - 180;
    const easeOutQuint = (t: number) => 1 - Math.pow(1 - t, 5);
    const rotateX = (p: Vec, deg: number): Vec => {
      const r = deg * TO_RAD;
      const c = Math.cos(r);
      const s = Math.sin(r);
      return [p[0], p[1] * c - p[2] * s, p[1] * s + p[2] * c];
    };
    const rotateY = (p: Vec, deg: number): Vec => {
      const r = deg * TO_RAD;
      const c = Math.cos(r);
      const s = Math.sin(r);
      return [p[0] * c + p[2] * s, p[1], -p[0] * s + p[2] * c];
    };

    // Fully curved cylinder: the radius is the one that closes the ring exactly.
    const pitch = CARD_W + GAP;
    const radius = (count * pitch) / (2 * Math.PI);

    const tiles = Array.from({ length: TILES }, (_, index) => {
      const length = CARD_W / TILES;
      const start = index * length - (index > 0 ? OVERLAP / 2 : 0);
      const end = (index + 1) * length + (index < TILES - 1 ? OVERLAP / 2 : 0);
      const center = (start + end) / 2 - CARD_W / 2;
      const alpha = center / radius;
      const shift = radius * Math.sin(alpha);
      const sink = radius * (1 - Math.cos(alpha));
      const turn = (-alpha * 180) / Math.PI;
      return {
        index,
        start,
        end,
        size: end - start,
        move: `translate3d(${shift}px, 0px, ${-sink}px) rotateY(${-turn}deg)`,
      };
    });

    const div = (className: string) => {
      const el = document.createElement('div');
      el.className = className;
      return el;
    };

    const buildTile = (src: HTMLElement, tile: (typeof tiles)[number], back: boolean) => {
      const strip = back ? TILES - 1 - tile.index : tile.index;
      const first = strip === 0;
      const last = strip === TILES - 1;
      const r = `${CORNER}px`;
      const el = div('cc__tile');
      el.style.cssText = `left:${-tile.size / 2}px;top:${-CARD_H / 2}px;width:${tile.size}px;height:${CARD_H}px;transform:${tile.move}${back ? ' rotateY(180deg)' : ''}`;
      const frame = div('cc__frame');
      frame.classList.toggle('is-first', first);
      frame.classList.toggle('is-last', last);
      frame.style.borderRadius = `${first ? r : 0} ${last ? r : 0} ${last ? r : 0} ${first ? r : 0}`;
      const offset = back ? CARD_W - tile.end : tile.start;
      const slice = div(back ? 'cc__slice cc__slice--back' : 'cc__slice');
      slice.style.cssText = `left:${-offset}px;width:${CARD_W}px;height:${CARD_H}px`;
      if (!back) {
        const copy = src.cloneNode(true) as HTMLElement;
        copy.removeAttribute('data-cc-item');
        copy.querySelectorAll('img').forEach((img) => {
          img.loading = 'eager';
        });
        slice.append(copy);
      }
      frame.append(slice, div('cc__shade'));
      el.append(frame);
      return el;
    };

    const cards: HTMLElement[] = [];
    for (let i = 0; i < count; i++) {
      const card = div('cc__card');
      card.dataset.ccIndex = String(i);
      for (const back of [false, true]) for (const tile of tiles) card.append(buildTile(sources[i % unique], tile, back));
      ring.append(card);
      cards.push(card);
    }

    const state = {
      angle: 0,
      velocity: 0,
      target: null as number | null,
      dir: -1,
      press: null as null | {
        id: number;
        x: number;
        y: number;
        angle: number;
        moved: boolean;
        origin: number;
        samples: { time: number; angle: number }[];
      },
      drag: false,
      hover: false,
      pointer: { inside: false, x: 0, y: 0 },
      yaw: 0,
      pitch: 0,
      introStart: 0,
      introDone: reduced,
      holdUntil: 0,
      suppressClick: false,
      fit: 1,
      drop: 400,
      last: 0,
    };

    let raf = 0;
    let visible = false;
    let active = -1;

    const nearest = (angle: number) => Math.round(angle / step) * step;

    const measure = () => {
      const rect = root.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      const width = rect.width * 0.94;
      const height = rect.height * 0.92;
      let minX = Infinity;
      let maxX = -Infinity;
      let minY = Infinity;
      let maxY = -Infinity;
      const corners: [number, number][] = [
        [-CARD_W / 2, -CARD_H / 2],
        [CARD_W / 2, -CARD_H / 2],
        [-CARD_W / 2, CARD_H / 2],
        [CARD_W / 2, CARD_H / 2],
      ];
      for (let a = -180; a <= 180; a += 180 / 24) {
        for (const [cx, cy] of corners) {
          let p = rotateX(rotateY([cx, cy, radius], a), TILT);
          p = [p[0], p[1], p[2] - radius];
          if (p[2] >= PERSPECTIVE * 0.95) continue;
          const k = PERSPECTIVE / (PERSPECTIVE - p[2]);
          minX = Math.min(minX, p[0] * k);
          maxX = Math.max(maxX, p[0] * k);
          minY = Math.min(minY, p[1] * k);
          maxY = Math.max(maxY, p[1] * k);
        }
      }
      const spanX = Math.max(maxX - minX, 1);
      const spanY = Math.max(maxY - minY, 1);
      let fit = Math.min(1, width / spanX, height / spanY);
      // On phones keep the front card readable and let the ring run off the edges.
      if (rect.width < 700) fit = Math.max(fit, Math.min(0.82, height / spanY));
      state.fit = fit;
      state.drop = (rect.height / fit) * 0.55 + CARD_H;
      stage.style.perspective = `${PERSPECTIVE}px`;
      stage.style.transform = `translate3d(0, ${-((minY + maxY) / 2) * fit}px, 0) scale(${fit})`;
    };

    const render = (now: number) => {
      const elapsed = state.introStart ? now - state.introStart : 0;
      camera.style.transform = `translate3d(0, 0, ${-radius}px) rotateX(${TILT + state.pitch}deg) rotateY(${state.yaw}deg)`;
      ring.style.transform = `rotateY(${state.angle}deg)`;

      for (let i = 0; i < count; i++) {
        const base = i * step;
        let transform = `rotateY(${base}deg) translateZ(${radius}px)`;
        if (!state.introDone && state.introStart) {
          const reach = Math.abs(wrap(base + state.angle));
          const delay = (reach / 180) * 480;
          const p = easeOutQuint(clamp((elapsed - delay) / 900, 0, 1));
          transform += ` translateY(${(1 - p) * state.drop}px)`;
        }
        cards[i].style.transform = transform;
        const facing = Math.cos(wrap(base + state.angle) * TO_RAD);
        const fade = DEPTH_FADE * Math.pow((1 - facing) / 2, 1.25);
        cards[i].style.setProperty('--cc-depth', fade.toFixed(3));
      }

      const index = ((Math.round(-state.angle / step) % count) + count) % count;
      const front = index % unique;
      if (front !== active) {
        active = front;
        dots.forEach((dot, d) => {
          if (d === front) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
        const title = sources[front].querySelector('h3')?.textContent ?? '';
        if (live) live.textContent = `${title}, ${front + 1} of ${unique}`;
      }
    };

    // Returns true while something is still moving.
    const advance = (dt: number, now: number) => {
      if (!state.introDone && state.introStart && now - state.introStart >= INTRO_MS) state.introDone = true;
      const intro = !state.introDone;
      const paused = state.hover || state.drag || now < state.holdUntil;
      const cruise = !reduced && !paused && !intro ? SPEED * state.dir : 0;
      let busy = intro || state.drag;

      if (state.drag || intro) {
        if (!state.drag) state.velocity = 0;
      } else if (state.target !== null) {
        let remaining = dt;
        const damping = 2 * Math.sqrt(SPRING);
        while (remaining > 0) {
          const h = Math.min(remaining, 1 / 240);
          state.velocity += (SPRING * (state.target - state.angle) - damping * state.velocity) * h;
          state.angle += state.velocity * h;
          remaining -= h;
        }
        if (Math.abs(state.target - state.angle) < 0.004 && Math.abs(state.velocity) < 0.03) {
          state.angle = state.target;
          state.velocity = 0;
          state.target = null;
        }
        busy = true;
      } else {
        const tau = 0.18 + MOMENTUM * 1.5;
        state.velocity += (cruise - state.velocity) * (1 - Math.exp(-dt / tau));
        state.angle += state.velocity * dt;
        if (cruise === 0 && Math.abs(state.velocity) < SETTLE_SPEED) state.target = nearest(state.angle);
        busy = busy || cruise !== 0 || Math.abs(state.velocity) > 0.01 || state.target !== null;
      }

      if (now < state.holdUntil) busy = true;

      const ease = 1 - Math.exp(-dt / 0.35);
      const aimYaw = state.pointer.inside && !reduced ? state.pointer.x * PARALLAX * 9 : 0;
      const aimPitch = state.pointer.inside && !reduced ? -state.pointer.y * PARALLAX * 6 : 0;
      state.yaw += (aimYaw - state.yaw) * ease;
      state.pitch += (aimPitch - state.pitch) * ease;
      if (Math.abs(aimYaw - state.yaw) > 0.01 || Math.abs(aimPitch - state.pitch) > 0.01) busy = true;
      return busy;
    };

    const frame = (now: number) => {
      raf = 0;
      const dt = state.last ? Math.min((now - state.last) / 1000, 0.05) : 1 / 60;
      state.last = now;
      const busy = advance(dt, now);
      render(now);
      if (busy && visible && !document.hidden) raf = requestAnimationFrame(frame);
      else state.last = 0;
    };
    const wake = () => {
      if (!raf && visible && !document.hidden) raf = requestAnimationFrame(frame);
    };

    // Everything below is input: buttons, dots, keys, pointer drag.
    const hold = () => {
      state.holdUntil = performance.now() + 2800;
    };
    const stepBy = (delta: number) => {
      const base = state.target ?? nearest(state.angle);
      state.target = base - delta * step;
      hold();
      wake();
    };
    const focusIndex = (index: number) => {
      let target = -index * step;
      target += 360 * Math.round((state.angle - target) / 360);
      state.target = target;
      hold();
      wake();
    };
    const focusIndustry = (u: number) => {
      // Either copy of the industry will do; take whichever is closest to the front.
      let best = u;
      let bestDist = Infinity;
      for (let k = u; k < count; k += unique) {
        let target = -k * step;
        target += 360 * Math.round((state.angle - target) / 360);
        const dist = Math.abs(target - state.angle);
        if (dist < bestDist) {
          bestDist = dist;
          best = k;
        }
      }
      focusIndex(best);
    };

    prevBtn?.addEventListener('click', () => stepBy(-1));
    nextBtn?.addEventListener('click', () => stepBy(1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => focusIndustry(i)));

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') stepBy(1);
      else if (e.key === 'ArrowLeft') stepBy(-1);
      else if (e.key === 'Home') focusIndustry(0);
      else if (e.key === 'End') focusIndustry(unique - 1);
      else return;
      e.preventDefault();
    });

    const updatePointer = (e: PointerEvent) => {
      const rect = root.getBoundingClientRect();
      state.pointer.x = clamp(((e.clientX - rect.left) / rect.width) * 2 - 1, -1, 1);
      state.pointer.y = clamp(((e.clientY - rect.top) / rect.height) * 2 - 1, -1, 1);
    };

    root.addEventListener('pointerdown', (e) => {
      state.suppressClick = false;
      if (e.button !== 0) return;
      state.press = {
        id: e.pointerId,
        x: e.clientX,
        y: e.clientY,
        angle: state.angle,
        moved: false,
        origin: 0,
        samples: [{ time: performance.now(), angle: state.angle }],
      };
    });

    root.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'mouse') {
        state.pointer.inside = true;
        updatePointer(e);
      }
      const press = state.press;
      if (!press || press.id !== e.pointerId) {
        wake();
        return;
      }
      const dx = e.clientX - press.x;
      const dy = e.clientY - press.y;
      if (!press.moved) {
        if (Math.abs(dx) < DRAG_THRESHOLD) return;
        if (Math.abs(dy) > Math.abs(dx) * 1.2 && e.pointerType !== 'mouse') {
          state.press = null; // vertical gesture: let the page scroll
          return;
        }
        press.moved = true;
        press.origin = dx;
        state.drag = true;
        state.target = null;
        state.velocity = 0;
        root.toggleAttribute('data-dragging', true);
        try {
          root.setPointerCapture(e.pointerId);
        } catch {
          /* pointer already released */
        }
      }
      const perPixel = 180 / (Math.PI * radius * state.fit);
      state.angle = press.angle + (dx - press.origin) * perPixel;
      const now = performance.now();
      press.samples.push({ time: now, angle: state.angle });
      while (press.samples.length > 2 && now - press.samples[0].time > 110) press.samples.shift();
      wake();
    });

    const release = (e: PointerEvent) => {
      const press = state.press;
      if (!press || press.id !== e.pointerId) return;
      state.press = null;
      if (!press.moved) return;
      state.drag = false;
      root.removeAttribute('data-dragging');
      state.suppressClick = true;
      const first = press.samples[0];
      const last = press.samples[press.samples.length - 1];
      const span = (last.time - first.time) / 1000;
      const velocity = span > 0.008 ? clamp((last.angle - first.angle) / span, -1400, 1400) : 0;
      state.velocity = velocity;
      if (Math.abs(velocity) > 60) state.dir = Math.sign(velocity);
      const coasting = !reduced && !(state.hover && e.pointerType === 'mouse');
      if (!coasting) {
        const tau = 0.18 + MOMENTUM * 1.5;
        state.target = Math.round((state.angle + velocity * tau * 0.55) / step) * step;
      }
      wake();
    };
    root.addEventListener('pointerup', release);
    root.addEventListener('pointercancel', release);

    root.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      state.hover = true;
      wake();
    });
    root.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse') {
        state.hover = false;
        state.pointer.inside = false;
      }
      wake();
    });

    root.addEventListener('click', (e) => {
      if (state.suppressClick) {
        state.suppressClick = false;
        return;
      }
      const card = (e.target as HTMLElement).closest<HTMLElement>('[data-cc-index]');
      if (card) focusIndex(Number(card.dataset.ccIndex));
    });

    new ResizeObserver(() => {
      measure();
      wake();
    }).observe(root);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(raf);
        raf = 0;
        state.last = 0;
      } else wake();
    });

    // Start the rise-in the first time the ring is on screen, then pause whenever it is off screen.
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) {
        if (!state.introStart && !reduced) state.introStart = performance.now();
        root.classList.add('is-ready');
        wake();
      } else {
        cancelAnimationFrame(raf);
        raf = 0;
        state.last = 0;
      }
    }).observe(root);

    measure();
    render(performance.now());
  }
</script>
