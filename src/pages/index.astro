---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import ProductSection from '../components/ProductSection.astro';
import SuiteBand from '../components/SuiteBand.astro';
import Multilingual from '../components/Multilingual.astro';
import Numbers from '../components/Numbers.astro';
import Pilot from '../components/Pilot.astro';
import Enterprise from '../components/Enterprise.astro';
import WhoItsFor from '../components/WhoItsFor.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import { verdicta, veritune } from '../data/copy';
---

<Base>
  <Nav />
  <main id="main">
    <Hero />
    <Problem />
    <ProductSection product={verdicta} />
    <ProductSection product={veritune} mirrored />
    <SuiteBand />
    <Multilingual />
    <Numbers />
    <Pilot />
    <Enterprise />
    <WhoItsFor />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Base>
