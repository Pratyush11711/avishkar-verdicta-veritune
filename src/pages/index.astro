---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import ProductSection from '../components/ProductSection.astro';
import SuiteBand from '../components/SuiteBand.astro';
import Multilingual from '../components/Multilingual.astro';
import Numbers from '../components/Numbers.astro';
import Pilot from '../components/Pilot.astro';
import Enterprise from '../components/Enterprise.astro';
import WhoItsFor from '../components/WhoItsFor.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import { verdicta, veritune } from '../data/copy';
---

<Base>
  <Nav />
  <main id="main">
    <Hero />
    <div class="panel panel-cool">
      <Problem />
      <ProductSection product={verdicta} slideFrom="right" />
    </div>
    <div class="panel panel-mint">
      <ProductSection product={veritune} mirrored splitSlide />
    </div>
    <SuiteBand />
    <Multilingual />
    <Numbers />
    <Pilot />
    <Enterprise />
    <WhoItsFor />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Base>

<style>
  .panel {
    margin: 0.25rem clamp(0.75rem, 1.6vw, 1.75rem) 1.75rem;
    border-radius: clamp(1.25rem, 1.6vw, 2rem);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 0 0 1px var(--panel-edge);
  }

  /* Problem and Verdicta: cool blue-green. */
  .panel-cool {
    --panel-edge: color-mix(in srgb, var(--color-sky) 24%, transparent);
    background:
      radial-gradient(ellipse 40rem 16rem at 8% 0, color-mix(in srgb, var(--color-sky) 28%, transparent), transparent 70%),
      radial-gradient(ellipse 34rem 18rem at 96% 100%, color-mix(in srgb, var(--color-aqua) 22%, transparent), transparent 72%),
      linear-gradient(165deg, #eef5f8 0%, #e6f2ef 52%, #eef3f6 100%);
  }

  /* Veritune: mint, so it reads apart from the blue-green panel above. */
  .panel-mint {
    --panel-edge: color-mix(in srgb, var(--color-mint) 55%, transparent);
    background:
      radial-gradient(ellipse 40rem 16rem at 92% 0, color-mix(in srgb, var(--color-mint) 42%, transparent), transparent 70%),
      radial-gradient(ellipse 34rem 18rem at 6% 100%, color-mix(in srgb, var(--color-mint) 28%, transparent), transparent 72%),
      linear-gradient(165deg, #f3faf6 0%, #e7f5ee 52%, #f1f8f4 100%);
  }
</style>
